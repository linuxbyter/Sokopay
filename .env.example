# Neon Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Ably (for real-time notifications)
# Get your keys at https://ably.com
ABLY_APP_ID=your_ably_app_id
ABLY_API_KEY=your_ably_api_key
NEXT_PUBLIC_ABLY_APP_ID=your_ably_app_id
NEXT_PUBLIC_ABLY_API_KEY=your_ably_api_key

# Web Push / PWA notifications (VAPID keys)
# Generate your own with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
